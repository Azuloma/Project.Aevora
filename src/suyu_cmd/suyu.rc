#include "winresrc.h"
/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Numeric id 1: named entries sort first and would win the shell's icon pick.
// Static launchers carry the Aevora game icon; SetWindowIcon reads this id.
#ifdef SUYU_CMD_STATIC_RECOMP
1                       ICON                    "../../dist/aevora_game.ico"
#else
1                       ICON                    "../../dist/suyu.ico"
#endif


/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

0                       RT_MANIFEST             "../../dist/suyu.manifest"
